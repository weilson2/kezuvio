  "fixed_sql": [
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"normalized_name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"active\" IN (0, 1)), \"default_key\" TEXT NULL UNIQUE, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"normalized_name\", \"kind\"), CHECK (kind IN ('income', 'expense')));"
        }
      ]
    },
    {
      "name": "entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"entries\" (\"id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"amount_sen\" INTEGER NOT NULL, \"currency\" TEXT NOT NULL DEFAULT 'MYR', \"business_date\" TEXT NOT NULL, \"occurred_at_local\" TEXT NOT NULL, \"time_zone_id\" TEXT NOT NULL DEFAULT 'Asia/Kuala_Lumpur', \"category_id\" TEXT NULL REFERENCES categories (id), \"note\" TEXT NOT NULL DEFAULT '', \"refund_direction\" TEXT NULL, \"original_transaction_id\" TEXT NULL REFERENCES entries (id), \"from_label\" TEXT NULL, \"to_label\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"revision\" INTEGER NOT NULL DEFAULT 0, \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"), CHECK (length(id) = 36), CHECK (type IN ('income', 'expense', 'refund', 'transfer')), CHECK (amount_sen > 0 AND amount_sen <= 999999999999), CHECK (currency = 'MYR' AND time_zone_id = 'Asia/Kuala_Lumpur'), CHECK (business_date GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]' AND date(business_date, '+0 days') IS NOT NULL AND date(business_date, '+0 days') = business_date AND business_date >= '1900-01-01' AND business_date < '9999-01-01'), CHECK (occurred_at_local = business_date || 'T00:00:00'), CHECK ((type = 'refund' AND refund_direction IS NOT NULL AND refund_direction IN ('customer_out','supplier_in')) OR (type <> 'refund' AND refund_direction IS NULL AND original_transaction_id IS NULL)), CHECK (type <> 'refund' OR original_transaction_id IS NOT NULL OR length(trim(note)) > 0), CHECK ((type = 'transfer' AND category_id IS NULL AND from_label IS NOT NULL AND to_label IS NOT NULL AND length(trim(from_label)) BETWEEN 1 AND 80 AND length(trim(to_label)) BETWEEN 1 AND 80 AND lower(trim(from_label)) <> lower(trim(to_label))) OR (type <> 'transfer' AND from_label IS NULL AND to_label IS NULL)), CHECK (original_transaction_id IS NULL OR original_transaction_id <> id), CHECK (deleted_at IS NULL));"
        }
      ]
    },
    {
      "name": "attachments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"attachments\" (\"id\" TEXT NOT NULL, \"transaction_id\" TEXT NOT NULL REFERENCES entries (id) ON DELETE CASCADE, \"local_path\" TEXT NOT NULL UNIQUE, \"mime_type\" TEXT NOT NULL, \"size_bytes\" INTEGER NOT NULL, \"checksum\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK (mime_type IN ('image/jpeg','image/png','application/pdf')), CHECK (size_bytes > 0 AND size_bytes <= 10485760), CHECK (length(checksum) = 64), CHECK (local_path NOT LIKE '/%' AND instr(local_path, '..') = 0 AND instr(local_path, ':') = 0 AND instr(local_path, char(92)) = 0));"
        }
      ]
    },
