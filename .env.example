# Copy to apps/website/.env.local when real details are available.
# Leave blank for an honest local-only enquiry preview.
NEXT_PUBLIC_CONTACT_EMAIL=
# International digits only, e.g. a real Malaysian number prefixed by 60.
NEXT_PUBLIC_WHATSAPP=
# Set only to a confirmed production origin before an approved launch.
# When blank, search indexing is disabled and metadata uses localhost.
SITE_URL=
# Behind an approved HTTPS reverse proxy, set the exact browser-facing origin
# (scheme + host + optional port, no trailing slash) for demo mutation checks.
DEMO_ORIGIN=
