{
  "name": "kezuvio-labs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev apps/website --hostname 127.0.0.1",
    "build": "npm run brand:generate && next build apps/website",
    "start": "next start apps/website --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit -p apps/website/tsconfig.json",
    "brand:generate": "node scripts/generate-brand.mjs",
    "test": "node scripts/check-brand.mjs && node --test tests/demo-engine.test.mjs && playwright test",
    "test:unit": "node --test tests/demo-engine.test.mjs",
    "pdf:brand": "node scripts/export-brand-presentation.mjs",
    "marketing:generate": "node scripts/generate-marketing.mjs && node scripts/generate-marketing-previews.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  }
}
